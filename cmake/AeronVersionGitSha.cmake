# Writes a header defining AERON_VERSION_GITSHA as the current commit, with "+guilty" appended when tracked files have
# uncommitted changes. Run with cmake -P on every build so the C SHA follows the working tree, as the Java build does.
# The header is only rewritten when the value changes, so sources that include it are only recompiled then.
#
# Required variables: SOURCE_DIR (the git working tree) and OUTPUT_FILE (the header to write).

execute_process(
    COMMAND git log -1 --format=%h --abbrev=10
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE AERON_VERSION_GITSHA
    OUTPUT_STRIP_TRAILING_WHITESPACE
)

execute_process(
    COMMAND git diff-index --quiet HEAD --
    WORKING_DIRECTORY ${SOURCE_DIR}
    RESULT_VARIABLE AERON_GIT_DIFF_INDEX_RESULT
)

if (NOT AERON_GIT_DIFF_INDEX_RESULT EQUAL 0)
    set(AERON_VERSION_GITSHA "${AERON_VERSION_GITSHA}+guilty")
endif ()

file(CONFIGURE
    OUTPUT ${OUTPUT_FILE}
    CONTENT "/* Generated by cmake/AeronVersionGitSha.cmake. Do not edit. */
#ifndef AERON_VERSION_GITSHA_H
#define AERON_VERSION_GITSHA_H

#define AERON_VERSION_GITSHA \"@AERON_VERSION_GITSHA@\"

#endif /* AERON_VERSION_GITSHA_H */
"
    @ONLY)
